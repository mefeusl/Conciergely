# Copy this file to ".env" and fill it in. NEVER share the .env file or paste it into a chat.

# --- Claude (https://console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Voice notes (optional, https://platform.openai.com -> API keys) ---
OPENAI_API_KEY=

# Optional: live flight status (RapidAPI "AeroDataBox" key). Without it, flights are looked up by web search.
AERODATABOX_KEY=
# Flight offers (prices, times, stops) from Google Flights via SerpApi; free plan = 250 searches/month. Optional.
SERPAPI_KEY=
MAX_FLIGHT_SEARCHES_PER_DAY=10
# Claude's built-in web search for live information. Needs web search enabled for your Anthropic account.
WEB_SEARCH=1

# --- WhatsApp through Meta Cloud API ---
WHATSAPP_PROVIDER=meta
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
# Any long random text you invent. You type the same text into the Meta webhook screen.
META_VERIFY_TOKEN=
META_WABA_ID=
# Optional: name of an approved message template with exactly one {{1}} in the body.
# Needed to send reminders/alerts to a client who has been silent for over 24 hours.
META_TEMPLATE_NAME=
META_TEMPLATE_LANG=tr

# --- Admin page (https://bot.example.com/admin, user name: admin) ---
# At least 12 characters. Leave empty to switch the admin page off.
ADMIN_PASSWORD=
PUBLIC_BASE_URL=https://bot.example.com

# --- Behaviour ---
BOT_NAME=Conciergely
TIMEZONE=Europe/Istanbul
ALERT_CHECK_MINUTES=5
ALERT_DEFAULT_THRESHOLD_PCT=3
HISTORY_TURNS=8
WORKER_THREADS=2
MAX_INBOUND_PER_HOUR=60
MAX_FILES_PER_HOUR=20

# --- Abuse protection (a frozen client is told to call this number) ---
OWNER_PHONE=
ABUSE_HUGE_CHARS=2500
ABUSE_HUGE_PER_HOUR=6
ABUSE_TOKENS_PER_HOUR=1000000

# --- Plans, routing, briefing (all optional) ---
# Features only the Plus plan gets (remove a word to give it to everyone): flights, trading, briefing
PLUS_ONLY=trading,briefing,mail
# Free Plus trial for each new client, in days, counted from their first message (0 = no trial)
TRIAL_DAYS=7
# Optional monthly caps override, e.g. {"basic":{"voice":100},"plus":{"flights":40}}
PLAN_LIMITS_JSON=
# Cheap model for short plain chat; MODEL_ROUTING=0 always uses CLAUDE_MODEL
MODEL_FAST=claude-haiku-5-5
MODEL_ROUTING=1
# Morning briefing: default time when a client just says "yes", late-start window, voice
BRIEFING_DEFAULT_MINUTES=510
BRIEFING_GRACE_MINUTES=180
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Set to 1 to test without sending real WhatsApp messages (they are only logged).
DRY_RUN=0

# --- Only if you use Twilio instead of Meta (WHATSAPP_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Email (Plus): read, draft and send on demand with an app password (IMAP/SMTP) ---
# Make a key ONCE and keep a copy outside the server:
#   python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# It seals every mail login (and the calling key). Not stored in the database or backups. Empty = email is switched off.
MAIL_MASTER_KEY=
# Only while changing the key: the previous key(s), comma separated. Then press "Re-seal logins" in /admin > Settings.
MAIL_MASTER_KEY_OLD=
MAIL_DRAFT_MINUTES=30
# Sending mail from a host that blocks SMTP (DigitalOcean): the relay on a second server. See relay/README.md.
# The URL must start with https://. Both lines are printed by relay/install.sh. Empty = send directly.
MAIL_RELAY_URL=
MAIL_RELAY_KEY=

# --- Calling add-on: OFF until you switch it on in /admin > Settings ---
CALLS_PER_DAY=3

# --- Nightly database copy (03:40). Copy this folder off the server too. ---
BACKUP_DIR=data/backups
BACKUP_KEEP=14

# --- Landing page (served at "/"). All optional; empty ones are simply not shown. ---
CONTACT_EMAIL=
CONTACT_WHATSAPP=
CONTACT_PHONE=
CONTACT_WEBSITE=

# Cost estimate shown in /admin (US dollars, estimates only; match them to your real plans)
COST_IN_PER_M=3
COST_OUT_PER_M=15
COST_VOICE=0.003
COST_BRIEFING=0.03
COST_FLIGHT=0.015
# Optional: show lira, and each client's cost as a share of the monthly fee
USD_TRY=
MONTHLY_FEE_TL=

# --- Billing by bank transfer (leave BILLING_ON=0 until the bank details below are filled in) ---
BILLING_ON=0
BANK_IBAN=
BANK_HOLDER=
BANK_NAME=
PRICE_BASIC_MONTH=1000
PRICE_PLUS_MONTH=2000
SETUP_BASIC=1000
SETUP_PLUS=2000
HALF_PRICE_MONTHS=2
HALF_PRICE_PERCENT=50
REMIND_DAYS_BEFORE=5
LAST_REMINDER_DAYS_AFTER=2
FREEZE_DAYS_AFTER=4
GRACE_DAYS=3

# Voice setup: new clients get a personal link to answer the setup questions by speaking.
# Needs OPENAI_API_KEY and an https PUBLIC_BASE_URL. Off until VOICE_SETUP=1.
VOICE_SETUP=0
VOICE_LINK_HOURS=48
VOICE_MAX_TURNS=40

# Speech to text: better model than whisper-1 (falls back to it by itself). TRANSCRIBE_LANG_HINT=1 tells it the client's language.
TRANSCRIBE_MODEL=gpt-4o-transcribe
TRANSCRIBE_LANG_HINT=0

# --- Lite plan, referrals and the extras (1028k) ---
PRICE_LITE_MONTH=500
SETUP_LITE=0
# Strangers who message the number get one reply per day; a valid REF-code signs them up (Basic + Plus trial).
REFERRALS_ON=1
REF_SIGNUPS_PER_DAY=10
REF_FRIEND_PCT=10
# Reward ladder for the inviter per paid friend: "friend number from : percent". Credits stack to at most 100 % and carry over.
REF_LADDER=1:25,3:35,6:50
# One-way fingerprint salt for 'was a client once'. Never change it after launch.
PHASH_SALT=conciergely-v1
# Voice: speaking style for gpt-4o-mini-tts (ignored by older voice models) and headline counts
TTS_VOICE=alloy
BRIEF_NEWS_TEXT=8
BRIEF_NEWS_VOICE=3
# Football data (TheSportsDB). Leave empty to use the free public key (limited lists); put a paid key here for full lists.
SPORTS_API_KEY=
# Seconds before a slow answer gets a "working on it" message (0 = never) and the first-day message after setup
WORKING_AFTER_SECONDS=5
WOW_ON=1
